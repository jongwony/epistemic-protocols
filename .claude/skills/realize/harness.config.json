{
  "runner": "claude",
  "configDir": "~/.claude-eval",
  "styleSource": "epistemic-cooperative/styles/epistemic-ink.md",
  "styleName": "Epistemic Ink",
  "models": [
    "claude-sonnet-5"
  ],
  "codex": {
    "stateDir": ".claude/skills/realize/.codex",
    "models": [
      "gpt-5.6-luna"
    ],
    "reasoningEffort": "xhigh",
    "timeoutSeconds": 420
  },
  "arms": {
    "bare": {
      "protocol": false,
      "style": false
    },
    "style": {
      "protocol": false,
      "style": true
    },
    "protocol": {
      "protocol": true,
      "style": false
    },
    "protocol+style": {
      "protocol": true,
      "style": true
    }
  },
  "runs": 1,
  "maxBudgetUsd": 2,
  "allowedTools": [
    "Read",
    "Grep",
    "Glob",
    "Bash",
    "Write",
    "Edit"
  ],
  "permissionMode": "acceptEdits",
  "targets": {
    "inquire": {
      "pluginDir": "aitesis",
      "protocolSkill": "inquire",
      "cases": [
        "inquire-underspecified",
        "inquire-fully-specified"
      ],
      "invocation": {
        "claude": "Use `/inquire` first, before any code gets written.",
        "codex": "Use `$aitesis:inquire` first, before any code gets written."
      }
    }
  }
}
