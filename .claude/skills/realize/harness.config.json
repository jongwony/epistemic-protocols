{
  "runner": "claude",
  "configDir": "~/.claude-eval",
  "pluginDir": "aitesis",
  "styleSource": "epistemic-cooperative/styles/epistemic-ink.md",
  "styleName": "Epistemic Ink",
  "models": [
    "claude-sonnet-5"
  ],
  "codex": {
    "stateDir": ".claude/skills/realize/.codex",
    "models": [
      "gpt-5.6-luna"
    ],
    "reasoningEffort": "xhigh",
    "timeoutSeconds": 420,
    "invocation": "Use `$aitesis:inquire` first, before any code gets written."
  },
  "arms": {
    "bare": {
      "protocol": false,
      "style": false
    },
    "style": {
      "protocol": false,
      "style": true
    },
    "protocol": {
      "protocol": true,
      "style": false
    },
    "protocol+style": {
      "protocol": true,
      "style": true
    }
  },
  "cases": [
    "inquire-underspecified",
    "inquire-fully-specified"
  ],
  "runs": 1,
  "maxBudgetUsd": 2,
  "allowedTools": [
    "Read",
    "Grep",
    "Glob",
    "Bash",
    "Write",
    "Edit"
  ],
  "permissionMode": "acceptEdits",
  "protocolSkill": "inquire",
  "invocation": "Use `/inquire` first, before any code gets written."
}
