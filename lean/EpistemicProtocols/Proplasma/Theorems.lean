module

public import Contract.Proplasma
public import EpistemicProtocols.Ground.Theorems

/-! The theorems the /preview contract guarantees, each stated and proved here; `Contract.Proplasma`
    is the SKILL.md Lean block, generated by lean-contract.js. Every public theorem is a guarantee
    the audit lists; a `private` theorem is a helper for one of them. -/

public section

open Ground

namespace Proplasma

variable {P : Type}

/-! Every judgment the block declares as an `axiom` has an inhabited type; these witnesses carry no
    meaning and exist so that no judgment can assume what nothing inhabits. -/

instance {A : Type} {q : Coord P A} {c : Context P} : Nonempty (Occ q c) := ⟨.open_ none⟩

theorem silence (ai : AITurns P) (c : Context P) : preview ai c [] = .holding c := by
  simp [preview]

theorem relay_before_instantiation (ai : AITurns P) (c : Context P) :
    ∃ t, fan ai c = c ++ [(ai.relay c).val] ++ t := by
  unfold fan
  simp only [List.append_assoc]
  exact ⟨_, rfl⟩

/-- The turn's fans enter the context with the first fan's relay before anything is built. -/
theorem fanned_relays_first (ai : AITurns P) (c : Context P) :
    ∃ t, fanned ai c = c ++ [(ai.relay c).val] ++ t := by
  simp only [fanned, consulted, fan, List.append_assoc]
  exact ⟨_, rfl⟩

/-- Every fan you carry on enters after the turn's first fan and what it made worth gathering, its
    relay immediately followed by what it builds. -/
theorem carried_fan_relays_first (ai : AITurns P) (c : Context P) (f : CarriedFan P)
    (h : f ∈ carried (consulted (fan ai c))) :
    ∃ s t, fanned ai c =
      consulted (fan ai c) ++ s ++ f.relay.val :: (f.built.map (·.val) ++ t) := by
  obtain ⟨l₁, l₂, hl⟩ := List.append_of_mem h
  refine ⟨l₁.flatMap (fun g => g.relay.val :: g.built.map (·.val)),
          l₂.flatMap (fun g => g.relay.val :: g.built.map (·.val)), ?_⟩
  simp only [fanned, hl, List.flatMap_append, List.flatMap_cons, List.append_assoc,
    List.cons_append]

theorem unrelated_adds_no_gate (ai : AITurns P) (c : Context P) (u : Utterance P)
    (us : List (Utterance P)) (h : ¬ Reaches (fuse c u)) :
    preview ai c (u :: us) = preview ai (fuse c u ++ [(ai.session (fuse c u)).val]) us := by
  simp [preview, h]

theorem no_fan_without_judgment (ai : AITurns P) (c : Context P) (u : Utterance P)
    (us : List (Utterance P)) (hr : Reaches (fuse c u))
    (hk : filledValue (closing (fuse c u)) = none)
    (hq : ¬ FanRequested (consulted (fuse c u))) (hc : ¬ FanCarried (consulted (fuse c u))) :
    preview ai c (u :: us) =
      preview ai (consulted (fuse c u) ++ [(ai.respond (consulted (fuse c u))).val]) us := by
  simp [preview, hr, hk, hq, hc]

/-- One step either continues on some context or ends at a closing the person's turn filled. -/
private theorem step (ai : AITurns P) (c : Context P) (u : Utterance P) (us : List (Utterance P))
    (o : Outcome P) (h : preview ai c (u :: us) = o) :
    (∃ c', preview ai c' us = o) ∨
    (∃ d, filledValue (closing (fuse c u)) = some (.constitute d) ∧
      o = .contrasted (constituted (fuse c u) d)) := by
  simp only [preview] at h
  split at h
  · exact .inl ⟨_, h⟩
  · split at h
    · rename_i d hk
      exact .inr ⟨d, hk, h.symm⟩
    · exact .inl ⟨_, h⟩

theorem contrasted_on_constitute (ai : AITurns P) (c : Context P) (us : List (Utterance P))
    (r : DirectionalContrast P) (h : preview ai c us = .contrasted r) :
    ∃ (c₁ : Context P) (d : Direction), filledValue (closing c₁) = some (.constitute d) ∧
      r.harvest = harvestOf c₁ d ∧ r.context = discard c₁ := by
  induction us generalizing c with
  | nil => simp [preview] at h
  | cons u us ih =>
    rcases step ai c u us _ h with ⟨c', h'⟩ | ⟨d, hk, h'⟩
    · exact ih c' h'
    · cases h'
      exact ⟨_, d, hk, rfl, rfl⟩

theorem closed_by_person (c : Context P) (k : Closing) (h : filledValue (closing c) = some k) :
    ∃ s : Cite c, s.src.val = .person ∧ (c[s.idx]'s.lt).origin = .person := by
  cases hc : closing c with
  | open_ _ => simp [hc, filledValue] at h
  | filled a src ok _ => exact ⟨src, ok, src.ok.trans ok⟩

theorem trace_total (c : Context P) : (discardTrace c).length = (probes c).length := by
  simp [discardTrace]

end Proplasma
