module

public import Contract.Harmoge

/-! The theorems the /fit contract guarantees, each stated and proved here; `Contract.Harmoge` is
    the SKILL.md Lean block, generated by lean-contract.js. Every public theorem is a guarantee the
    audit lists; a `private` theorem is a helper for one of them. -/

public section

open Ground

namespace Harmoge

variable {P : Type}

/-! Every judgment the block declares as an `axiom` has an inhabited type; these witnesses carry no
    meaning and exist so that no judgment can assume what nothing inhabits. -/

instance {A : Type} {q : Coord P A} {c : Context P} : Nonempty (Occ q c) := ⟨.open_ none⟩

instance {c : Context P} {k : Entry} : Nonempty (Replay c k) := ⟨⟨"", []⟩⟩

/-! The recursion, arm by arm. -/

theorem silence (respond session : Context P → Response P) (c : Context P) :
    fit respond session c [] = .holding c := by
  simp [fit]

theorem start_advances_first (respond session : Context P → Response P) (c : Context P)
    (us : List (Utterance P)) :
    start respond session c us =
      fit respond session (advance c ++ [(respond (advance c)).val]) us := rfl

theorem unrelated_adds_no_round (respond session : Context P → Response P) (c : Context P)
    (u : Utterance P) (us : List (Utterance P)) (h : ¬ Reaches (fuse c u)) :
    fit respond session c (u :: us) =
      fit respond session (fuse c u ++ [(session (fuse c u)).val]) us := by
  simp [fit, h]

/-- A taking fits, and the record is read on the context the taking turn met. -/
theorem taking_fits (respond session : Context P → Response P) (c : Context P)
    (u : Utterance P) (us : List (Utterance P)) (hre : Reaches (fuse c u))
    (ht : taken (fuse c u) = true) :
    fit respond session c (u :: us) = .fitted ⟨closed c, u⟩ := by
  simp [fit, hre, ht]

/-- A turn that bears on the run and takes nothing is answered by the work before a round, and
    then the round. -/
theorem untaken_advances_again (respond session : Context P → Response P) (c : Context P)
    (u : Utterance P) (us : List (Utterance P)) (hre : Reaches (fuse c u))
    (ht : taken (fuse c u) = false) :
    fit respond session c (u :: us) =
      fit respond session
        (advance (fuse c u) ++ [(respond (advance (fuse c u))).val]) us := by
  simp [fit, hre, ht]

theorem each_step_continues_or_fits (respond session : Context P → Response P) (c : Context P)
    (u : Utterance P) (us : List (Utterance P)) (o : Outcome P)
    (h : fit respond session c (u :: us) = o) :
    (∃ c', fit respond session c' us = o) ∨
    (Reaches (fuse c u) ∧ taken (fuse c u) = true ∧ o = .fitted ⟨closed c, u⟩) := by
  simp only [fit] at h
  split at h
  · exact .inl ⟨_, h⟩
  · split at h
    · exact .inr ⟨Classical.not_not.mp (by assumption), by assumption, h.symm⟩
    · exact .inl ⟨_, h⟩

/-! Provenance of a fitted run. -/

/-- A run ends fitted only on a person's utterance that bears on it and takes the space, and its
    record is the readings of the context that utterance met. -/
theorem fitted_by_person_taking (respond session : Context P → Response P) (c : Context P)
    (us : List (Utterance P)) (r : FittedSolutionSpace P)
    (h : fit respond session c us = .fitted r) :
    ∃ (c₀ : Context P) (u : Utterance P),
      Reaches (fuse c₀ u) ∧ taken (fuse c₀ u) = true ∧ r = ⟨closed c₀, u⟩ := by
  induction us generalizing c with
  | nil => simp [fit] at h
  | cons u us ih =>
    rcases each_step_continues_or_fits respond session c u us _ h with ⟨c', h'⟩ | ⟨hre, ht, h'⟩
    · exact ih c' h'
    · cases h'
      exact ⟨c, u, hre, ht, rfl⟩

/-- The record of a fitted run is read on the context its taking turn met: fusing that turn onto
    the record's context gives the context on which the taking was read. -/
theorem fitted_record_is_what_the_taking_met (respond session : Context P → Response P)
    (c : Context P) (us : List (Utterance P)) (r : FittedSolutionSpace P)
    (h : fit respond session c us = .fitted r) :
    r.shown = closed r.shown.context ∧ taken (fuse r.shown.context r.taking) = true := by
  rcases fitted_by_person_taking respond session c us r h with ⟨c₀, u, _, ht, rfl⟩
  exact ⟨rfl, ht⟩

/-- Where `taken` holds on a context ending in an utterance, the closure is filled, its own
    citation points at that utterance, and that turn is a person's. -/
theorem taken_cites_the_fused_turn (c : Context P) (u : Utterance P)
    (h : taken (fuse c u) = true) :
    ∃ (s : Cite (fuse c u)) (ok : (closureCoord (P := P)).admits s.src)
      (sup : ClosureSupported (fuse c u) ((fuse c u)[s.idx]'s.lt) ()),
      closure (fuse c u) = .filled () s ok sup ∧ s.idx = c.length ∧
        ((fuse c u)[s.idx]'s.lt) = u.val ∧ s.src.val = .person := by
  unfold taken at h
  split at h
  · simp at h
  · rename_i a s ok sup heq
    have hidx : s.idx = c.length := by
      have := of_decide_eq_true h
      simp [fuse] at this
      omega
    refine ⟨s, ok, sup, ?_, hidx, ?_, ok⟩
    · cases a; exact heq
    · simp [fuse, hidx]

/-! The records. -/

/-- The work before a round appends only turns a tool, the environment or a peer returned: no
    turn of the person's and none of the assistant's enters by gathering, carrying or running. -/
theorem advance_adds_only_evidence (c : Context P) :
    ∃ ev : List (Turn P), advance c = c ++ ev ∧
      ∀ e ∈ ev, e.origin = .external ∨ e.origin = .peer := by
  by_cases hr : RunInReach (carried (consulted c))
  · refine ⟨(gathered c).map (·.val) ++ (applied (consulted c)).map (·.val) ++
      (ran (carried (consulted c))).map (·.val), ?_, ?_⟩
    · have h : advance c =
          carried (consulted c) ++ (ran (carried (consulted c))).map (·.val) := by
        simp [advance, hr]
      rw [h]
      simp [carried, consulted, List.append_assoc]
    · intro e he
      simp only [List.mem_append, List.mem_map] at he
      rcases he with (⟨x, _, rfl⟩ | ⟨x, _, rfl⟩) | ⟨x, _, rfl⟩ <;> exact x.property
  · refine ⟨(gathered c).map (·.val) ++ (applied (consulted c)).map (·.val), ?_, ?_⟩
    · have h : advance c = carried (consulted c) := by simp [advance, hr]
      rw [h]
      simp [carried, consulted, List.append_assoc]
    · intro e he
      simp only [List.mem_append, List.mem_map] at he
      rcases he with ⟨x, _, rfl⟩ | ⟨x, _, rfl⟩ <;> exact x.property

/-- Where no run is in reach, the work before a round only gathers and carries; the rows still
    cover every case (`rows_cover_inventory`). -/
theorem unrun_advance_gathers_and_carries (c : Context P)
    (h : ¬ RunInReach (carried (consulted c))) :
    advance c = carried (consulted c) := by
  simp [advance, h]

theorem run_only_when_in_reach (c : Context P) (h : Op.run ∈ advanceOps c) :
    RunInReach (carried (consulted c)) :=
  Classical.byContradiction fun hn => by simp [advanceOps, hn] at h

/-- The rows are exactly the inventory, in order: every case gathered since the call has a row,
    whether or not anything ran. -/
theorem rows_cover_inventory (c : Context P) :
    (rows c).map (·.1) = cases c := by
  simp [rows, Function.comp_def]

/-- Each row is the replay and the judgment of its own case. -/
theorem rows_carry_their_case (c : Context P) :
    ∀ x ∈ rows c, x.2 = ⟨replay c x.1, judgment c x.1⟩ := by
  intro x hx
  simp only [rows, List.mem_map] at hx
  obtain ⟨k, -, rfl⟩ := hx
  rfl

/-- A case's filled judgment is a filled occurrence that cites a turn the person sent. -/
theorem judgment_by_person (c : Context P) (k : Entry) (h : isFilled (judgment c k) = true) :
    ∃ a src ok sup, judgment c k = .filled a src ok sup ∧
      (c[src.idx]'src.lt).origin = .person := by
  cases hj : judgment c k with
  | open_ _ => simp [hj, isFilled] at h
  | filled a src ok sup => exact ⟨a, src, ok, sup, rfl, src.ok.trans ok⟩

/-- A filled purpose is a filled occurrence that cites a turn the person sent. -/
theorem purpose_by_person (c : Context P) (h : isFilled (purpose c) = true) :
    ∃ a src ok sup, purpose c = .filled a src ok sup ∧
      (c[src.idx]'src.lt).origin = .person := by
  cases hp : purpose c with
  | open_ _ => simp [hp, isFilled] at h
  | filled a src ok sup => exact ⟨a, src, ok, sup, rfl, src.ok.trans ok⟩

/-- An attached return rests on a turn a tool, the environment or a peer sent, and on the span
    `ReturnSupports` read there. -/
theorem returned_on_evidence {c : Context P} {k : Entry} (r : Returned c k) :
    ((c[r.src.idx]'r.src.lt).origin = .external ∨ (c[r.src.idx]'r.src.lt).origin = .peer) ∧
      ReturnSupports c r.src r.span k :=
  ⟨by rw [r.src.ok]; exact r.byRun, r.supported⟩

theorem closed_only_by_person {c : Context P} {s : Cite c}
    (ok : (closureCoord (P := P)).admits s.src) : s.src.val = .person := ok

-- About the annotations TOOL GROUNDING declares: the only operation annotated `.transform` is
-- `.apply`, and the only ones annotated `.dispatch` are `.applyDelegate` and `.run`. It reads the
-- declaration, not what a run does.
theorem transforms_only_apply_dispatches_delegate_and_run (op : Op) :
    ((grounding op).1 = .transform ↔ op = .apply) ∧
      ((grounding op).1 = .dispatch ↔ op = .applyDelegate ∨ op = .run) := by
  cases op <;> simp [grounding]

end Harmoge
