module

public import Contract.Probe
public import EpistemicProtocols.Ground.Theorems

/-! The theorems the /probe contract guarantees, each stated and proved here; `Contract.Probe` is
    the SKILL.md Lean block, generated by lean-contract.js. Every public theorem is a guarantee
    the audit lists; a `private` theorem is a helper for one of them. -/

public section

open Ground

namespace Probe

variable {P : Type}

/-! Every judgment the block declares as an `axiom` has an inhabited type; these witnesses carry no
    meaning and exist so that no judgment can assume what nothing inhabits. -/

instance {A : Type} {q : Coord P A} {c : Context P} : Nonempty (Occ q c) := ⟨.open_ none⟩

/-- With no utterance the round holds: nothing is recognized and nothing closes. -/
theorem silence (catalog : Catalog) (respond : Catalog → Context P → Response P)
    (session : Context P → Response P) (c : Context P) :
    probe catalog respond session c [] = .holding c := by
  simp [probe]

/-- An activated run with no utterance holds after its first round; there is no close of yours. -/
theorem start_silence (catalog : Catalog) (respond : Catalog → Context P → Response P)
    (session : Context P → Response P) (c : Context P) (h : Activated c) :
    ∃ c', start catalog respond session c [] = .holding c' := by
  unfold start
  simp only [h, ↓reduceIte]
  exact ⟨_, silence catalog respond session _⟩

/-- Each step of the recursion either closes on a recognition or goes on with a context that
    extends the one before the utterance: nothing is removed from what the person and the reads
    put there. -/
theorem step_extends (catalog : Catalog) (respond : Catalog → Context P → Response P)
    (session : Context P → Response P) (c : Context P) (u : Utterance P)
    (us : List (Utterance P)) :
    (∃ r, probe catalog respond session c (u :: us) = .recognized r) ∨
      ∃ t, probe catalog respond session c (u :: us) =
        probe catalog respond session (c ++ t) us := by
  obtain ⟨t₀, ht₀⟩ := fuse_extends c u
  simp only [probe]
  split
  · exact Or.inr ⟨t₀ ++ [(session (fuse c u)).val], by rw [ht₀, List.append_assoc]⟩
  · split
    · next r _ => exact Or.inl ⟨r, rfl⟩
    · refine Or.inr ⟨t₀ ++ ((gathered (fuse c u)).map (·.val) ++
        [(respond catalog (pass (fuse c u))).val]), ?_⟩
      simp only [pass]
      rw [ht₀]
      simp [List.append_assoc]

/-- An utterance that does not bear on this run — one that ends the probe or turns to other work —
    raises no round and closes nothing: the session's answer joins the context and the run goes
    on as it stood. -/
theorem unrelated_raises_no_round (catalog : Catalog) (respond : Catalog → Context P → Response P)
    (session : Context P → Response P) (c : Context P) (u : Utterance P)
    (us : List (Utterance P)) (h : ¬ Reaches (fuse c u)) :
    probe catalog respond session c (u :: us) =
      probe catalog respond session (fuse c u ++ [(session (fuse c u)).val]) us := by
  simp [probe, h]

private theorem probe_ne_notActivated (catalog : Catalog)
    (respond : Catalog → Context P → Response P) (session : Context P → Response P)
    (d : Context P) :
    ∀ (us : List (Utterance P)) (c : Context P),
      probe catalog respond session c us ≠ .notActivated d := by
  intro us
  induction us with
  | nil => intro c; simp [probe]
  | cons u us ih =>
    intro c
    simp only [probe]
    split
    · exact ih _
    · split
      · intro h; cases h
      · exact ih _

/-- An invocation of the person's own always activates: the run never ends as not activated. -/
theorem invocation_activates (catalog : Catalog) (respond : Catalog → Context P → Response P)
    (session : Context P → Response P) (c : Context P) (us : List (Utterance P))
    (h : Invoked c) (d : Context P) : start catalog respond session c us ≠ .notActivated d := by
  have ha : Activated c := Or.inl h
  unfold start
  simp only [ha, ↓reduceIte]
  exact probe_ne_notActivated catalog respond session d _ _

private theorem closing_cases (catalog : Catalog) (c : Context P) (r : RecognizedSituation P)
    (h : closing catalog c = some r) :
    ∃ s : Cite c, s.idx + 1 = c.length ∧ (c[s.idx]'s.lt).origin = .person ∧
      AnswerSupported c (c[s.idx]'s.lt) r.answer ∧
      r = ⟨c, r.answer, shownIn catalog c, dissent c, s.idx⟩ ∧
      (∀ k b, r.answer = .shown k b → k ∈ shownIn catalog c) ∧
      (r.answer = .noneShown → shownIn catalog c ≠ []) := by
  unfold closing at h
  cases hA : answer c with
  | open_ x => rw [hA] at h; simp at h
  | filled a s ok sup =>
    rw [hA] at h
    simp only at h
    split at h
    · next hl =>
      cases a with
      | shown k b =>
        simp only at h
        split at h
        · next hg =>
          cases h
          refine ⟨s, hl, s.ok.trans ok, sup, rfl, ?_, ?_⟩
          · intro k₁ b₁ hk
            simp only [Answer.shown.injEq] at hk
            obtain ⟨rfl, -⟩ := hk
            exact hg
          · intro hn; cases hn
        · cases h
      | noneShown =>
        simp only at h
        split at h
        · cases h
        · next hn =>
          cases h
          refine ⟨s, hl, s.ok.trans ok, sup, rfl, ?_, ?_⟩
          · intro k₁ b₁ hk; cases hk
          · intro _; exact hn
      | reworded t =>
        simp only [Option.some.injEq] at h
        subst h
        refine ⟨s, hl, s.ok.trans ok, sup, rfl, ?_, ?_⟩
        · intro k₁ b₁ hk; cases hk
        · intro hn; cases hn
    · cases h

/-- A closing rests on the person's latest turn: the recognition it emits is read from the context
    it closes on, and cites that context's last turn, which the person sent and which supports its
    answer. -/
theorem closing_by_person (catalog : Catalog) (c : Context P) (r : RecognizedSituation P)
    (h : closing catalog c = some r) :
    ∃ s : Cite c, r.context = c ∧ s.idx = r.recognizedAt ∧ s.idx + 1 = c.length ∧
      (c[s.idx]'s.lt).origin = .person ∧ AnswerSupported c (c[s.idx]'s.lt) r.answer := by
  obtain ⟨s, hl, ho, hs, hr, -, -⟩ := closing_cases catalog c r h
  exact ⟨s, congrArg RecognizedSituation.context hr,
    (congrArg RecognizedSituation.recognizedAt hr).symm, hl, ho, hs⟩

/-- `noneShown` closes only where the round it answered offered candidates. -/
theorem none_shown_after_candidates (catalog : Catalog) (c : Context P)
    (r : RecognizedSituation P) (h : closing catalog c = some r) (hn : r.answer = .noneShown) :
    r.shown ≠ [] := by
  obtain ⟨_, -, -, -, hr, -, hne⟩ := closing_cases catalog c r h
  rw [congrArg RecognizedSituation.shown hr]
  exact hne hn

/-- A recognition records as shown exactly the candidates the round it answered offered: after a
    short round with one line, that one candidate, so no comparison is claimed. -/
theorem short_round_records_its_one (catalog : Catalog) (c : Context P)
    (r : RecognizedSituation P) (n : Fin c.length) (l : Line catalog (c.take n))
    (h : closing catalog c = some r) (hp : presented catalog c = some ⟨n, .short (some l)⟩) :
    r.shown = [l.candidate] := by
  obtain ⟨_, -, -, -, hr, -, -⟩ := closing_cases catalog c r h
  rw [congrArg RecognizedSituation.shown hr]
  simp [shownIn, hp, Presentation.shown, Presentation.lines]

/-- After a short round with no line only the person's own words close, and the recognition
    carries no shown candidates. -/
theorem after_empty_round_only_own_words (catalog : Catalog) (c : Context P)
    (r : RecognizedSituation P) (n : Fin c.length) (h : closing catalog c = some r)
    (hp : presented catalog c = some ⟨n, .short none⟩) :
    (∃ t, r.answer = .reworded t) ∧ r.shown = [] := by
  obtain ⟨_, -, -, -, hr, hk, hne⟩ := closing_cases catalog c r h
  have he : shownIn catalog c = [] := by
    simp [shownIn, hp, Presentation.shown, Presentation.lines]
  refine ⟨?_, by rw [congrArg RecognizedSituation.shown hr]; exact he⟩
  cases ha : r.answer with
  | shown k b => have := hk k b ha; rw [he] at this; cases this
  | noneShown => exact absurd he (hne ha)
  | reworded t => exact ⟨t, rfl⟩

private theorem probe_recognized (catalog : Catalog) (respond : Catalog → Context P → Response P)
    (session : Context P → Response P) (r : RecognizedSituation P) :
    ∀ (us : List (Utterance P)) (c : Context P),
      probe catalog respond session c us = .recognized r →
      ∃ c₀ : Context P, closing catalog c₀ = some r ∧ Reaches c₀ ∧ ¬ Owed c₀ := by
  intro us
  induction us with
  | nil => intro c h; simp [probe] at h
  | cons u us ih =>
    intro c h
    simp only [probe] at h
    split at h
    · exact ih _ h
    · next hre =>
      split at h
      · next r₁ hr =>
        cases h
        split at hr
        · cases hr
        · next ho => exact ⟨_, hr, Classical.not_not.mp hre, ho⟩
      · exact ih _ h

private theorem start_recognized (catalog : Catalog) (respond : Catalog → Context P → Response P)
    (session : Context P → Response P) (c : Context P) (us : List (Utterance P))
    (r : RecognizedSituation P) (h : start catalog respond session c us = .recognized r) :
    ∃ c₀ : Context P, closing catalog c₀ = some r ∧ Reaches c₀ ∧ ¬ Owed c₀ := by
  unfold start at h
  split at h
  · exact probe_recognized catalog respond session r _ _ h
  · cases h

/-- A recognition closes only where the latest utterance bears on the run and no turn of the
    person's is owed: contrary grounds they have not closed over, or a reply whose reading their
    words have not settled, hold every answer back alike. -/
theorem recognized_only_unowed (catalog : Catalog) (respond : Catalog → Context P → Response P)
    (session : Context P → Response P) (c : Context P) (us : List (Utterance P))
    (r : RecognizedSituation P) (h : start catalog respond session c us = .recognized r) :
    ∃ c₀ : Context P, closing catalog c₀ = some r ∧ r.context = c₀ ∧ Reaches c₀ ∧ ¬ Owed c₀ := by
  obtain ⟨c₀, hc₀, hre, ho⟩ := start_recognized catalog respond session c us r h
  obtain ⟨_, hctx, _⟩ := closing_by_person catalog c₀ r hc₀
  exact ⟨c₀, hc₀, hctx, hre, ho⟩

/-- Every situation a run recognizes was recognized by the person: a recognized outcome comes only
    from a closing — at any depth of the recursion, never from a close of yours — and that closing
    cites the last turn of the context it closes on, the person's latest utterance, which supports
    its answer. -/
theorem recognized_only_by_person (catalog : Catalog) (respond : Catalog → Context P → Response P)
    (session : Context P → Response P) (c : Context P) (us : List (Utterance P))
    (r : RecognizedSituation P) (h : start catalog respond session c us = .recognized r) :
    ∃ (c₀ : Context P) (s : Cite c₀), closing catalog c₀ = some r ∧ r.context = c₀ ∧
      s.idx = r.recognizedAt ∧ s.idx + 1 = c₀.length ∧ (c₀[s.idx]'s.lt).origin = .person ∧
      AnswerSupported c₀ (c₀[s.idx]'s.lt) r.answer := by
  obtain ⟨c₀, hc₀, _⟩ := start_recognized catalog respond session c us r h
  obtain ⟨s, hs⟩ := closing_by_person catalog c₀ r hc₀
  exact ⟨c₀, s, hc₀, hs⟩

private theorem shown_in_line (catalog : Catalog) (c : Context P) (k : Candidate)
    (h : k ∈ shownIn catalog c) :
    ∃ (n : Fin c.length) (p : Presentation catalog (c.take n)) (l : Line catalog (c.take n)),
      presented catalog c = some ⟨n, p⟩ ∧ l ∈ p.lines ∧ l.candidate = k := by
  unfold shownIn at h
  cases hp : presented catalog c with
  | none => rw [hp] at h; simp at h
  | some q =>
    rw [hp] at h
    obtain ⟨n, p⟩ := q
    simp only [Option.map_some, Option.getD_some, Presentation.shown, List.mem_map] at h
    obtain ⟨l, hl, hk⟩ := h
    exact ⟨n, p, l, rfl, hl, hk⟩

/-- A shown candidate is recognized only from a line a round of this run showed: the closing that
    took it read a presentation, on the context it was shown on, holding a line with that
    candidate, resting on at least one turn of that context, every ground citing a turn none of
    your own, and its skill, if any, one the catalog holds. -/
theorem shown_only_from_shown_line (catalog : Catalog)
    (respond : Catalog → Context P → Response P) (session : Context P → Response P)
    (c : Context P) (us : List (Utterance P)) (r : RecognizedSituation P) (k : Candidate)
    (b : Bool) (h : start catalog respond session c us = .recognized r)
    (hk : r.answer = .shown k b) :
    ∃ (c₀ : Context P) (n : Fin c₀.length) (p : Presentation catalog (c₀.take n))
      (l : Line catalog (c₀.take n)),
      closing catalog c₀ = some r ∧ presented catalog c₀ = some ⟨n, p⟩ ∧ l ∈ p.lines ∧
      l.candidate = k ∧ l.grounds ≠ [] ∧
      (∀ g ∈ l.grounds, ((c₀.take n)[g.src.idx]'g.src.lt).origin ≠ .assistant) ∧
      ∀ e, k.skill = some e → e ∈ catalog := by
  obtain ⟨c₀, hc₀, _⟩ := start_recognized catalog respond session c us r h
  obtain ⟨_, -, -, -, -, hsk, -⟩ := closing_cases catalog c₀ r hc₀
  obtain ⟨n, p, l, hp, hl, rfl⟩ := shown_in_line catalog c₀ k (hsk k b hk)
  exact ⟨c₀, n, p, l, hc₀, hp, hl, rfl, l.grounded, fun g _ => cited_not_assistant g.src,
    l.inCatalog⟩

/-- A run hands off only where the person took, at their latest turn, a candidate the round showed
    with the run of the skill its line showed: the dispatch follows an answer `.shown k true`
    whose candidate is among those the recognition records as shown, whose skill the catalog
    holds, and which the last turn of the closing context — the person's — supports. -/
theorem invokes_only_taken_skill (catalog : Catalog) (respond : Catalog → Context P → Response P)
    (session : Context P → Response P) (c : Context P) (us : List (Utterance P))
    (r : RecognizedSituation P) (h : start catalog respond session c us = .recognized r)
    (hi : invokedBy (.recognized r) = some .invoke) :
    ∃ (k : Candidate) (e : CatalogEntry) (c₀ : Context P) (s : Cite c₀),
      r.answer = .shown k true ∧ k.skill = some e ∧ k ∈ r.shown ∧ e ∈ catalog ∧
      closing catalog c₀ = some r ∧ s.idx = r.recognizedAt ∧ s.idx + 1 = c₀.length ∧
      (c₀[s.idx]'s.lt).origin = .person ∧ AnswerSupported c₀ (c₀[s.idx]'s.lt) r.answer := by
  obtain ⟨c₀, hc₀, _⟩ := start_recognized catalog respond session c us r h
  obtain ⟨s, hl, ho, hs, hr, hsk, -⟩ := closing_cases catalog c₀ r hc₀
  cases ha : r.answer with
  | shown k b =>
    cases b with
    | false => simp [invokedBy, ha, nextMove] at hi
    | true =>
      cases he : k.skill with
      | none => simp [invokedBy, ha, nextMove, he] at hi
      | some e =>
        have hmem := hsk k true ha
        obtain ⟨n, p, l, -, -, hlk⟩ := shown_in_line catalog c₀ k hmem
        refine ⟨k, e, c₀, s, rfl, he, ?_, l.inCatalog e (hlk ▸ he), hc₀,
          (congrArg RecognizedSituation.recognizedAt hr).symm, hl, ho, ha ▸ hs⟩
        rw [congrArg RecognizedSituation.shown hr]
        exact hmem
  | reworded t => simp [invokedBy, ha, nextMove] at hi
  | noneShown => simp [invokedBy, ha, nextMove] at hi

end Probe
